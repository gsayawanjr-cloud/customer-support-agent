# Customer support automation settings. Copy to .env and fill in. Never commit .env.

# Trigger.dev DEV secret key: cloud.trigger.dev → this project → API keys → Development (starts with tr_dev_).
TRIGGER_SECRET_KEY=

# Anthropic API key for THIS project: platform.claude.com → API keys → Create key (starts with sk-ant-).
ANTHROPIC_API_KEY=
# Claude model for reading emails and drafting replies. Opus 5.5 (~$0.03/ticket) is the chosen default.
SUPPORT_MODEL=claude-opus-5-5

# The Gmail account that receives support mail and holds the reply drafts.
SUPPORT_GMAIL_USER=
# Gmail app password (16 letters): myaccount.google.com/apppasswords, signed in as SUPPORT_GMAIL_USER (2-Step Verification must be on).
SUPPORT_GMAIL_APP_PASSWORD=
# Optional: the address customers write to. Default: SUPPORT_GMAIL_USER with +support (e.g. you+support@gmail.com).
SUPPORT_INBOX_ADDRESS=

# Google service account key (the whole JSON file on ONE line): console.cloud.google.com → IAM & Admin →
# Service accounts → your account → Keys → Add key → JSON. Share the sheet with the account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Google Sheet ID: the long part of the sheet URL between /d/ and /edit.
SUPPORT_SHEET_ID=

# Where handoff alerts go (your own email; must NOT be the +support address).
ALERT_EMAIL_TO=

# Store details used in replies.
STORE_NAME=Larkspur Home Goods
STORE_TIMEZONE=America/Los_Angeles
# Optional sign-off name under every reply. Default: "The <STORE_NAME> team".
SUPPORT_SIGNATURE=

# DEV ONLY: lets send-test-emails' mock customers (sent from your own Gmail) count as customers.
# Never uploaded to production (trigger.config.ts strips it).
SUPPORT_ALLOW_SELF_TEST=true
